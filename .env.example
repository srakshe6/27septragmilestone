# MF FAQ assistant - template for .env
#
# Copy to .env and fill in. .env itself is gitignored and must stay that way.
#     Windows:  copy .env.example .env
#     bash:     cp .env.example .env
#
# A value already set in the real environment wins over this file.

# ------------------------------------------------------------------ LLM (optional)
# Everything works with these blank; synthesis falls back to an extractive
# composer. No stage requires a network call.
MF_FAQ_LLM=1
MF_FAQ_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# openai/gpt-oss-120b is Groq's current flagship free-tier id. The old
# llama-3.3-70b-versatile id has been retired and now returns HTTP 404.
MF_FAQ_GROQ_MODEL=openai/gpt-oss-120b
# Reasoning models (gpt-oss, deepseek-r1, qwen3) bill their thinking against
# max_tokens, so the default budget of 300 is raised to 2048 for them and the
# request carries reasoning_effort. Override only if you switch models.
# MF_FAQ_LLM_MAX_TOKENS=2048
# MF_FAQ_LLM_REASONING_EFFORT=low
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
MF_FAQ_LLM_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# ------------------------------------------------------------------ embeddings
# "hashed" = zero dependencies. Otherwise a HuggingFace sentence-transformers
# model id (PRD: sentence-transformers/all-MiniLM-L6-v2); requires the package.
MF_FAQ_EMBED_MODEL=hashed

# ------------------------------------------------------------------ retrieval
# 1 = never open a socket; use the raw cache and the built index as-is.
MF_FAQ_OFFLINE=0